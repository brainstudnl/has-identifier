{
  "name": "brainstud/has-identifier",
  "description": "Add a HasIdentifier to the model to take care of generating the identifier",
  "require": {
    "php": "^8.3",
    "laravel/framework": "^11.0 || ^12.0 || ^13.0"
  },
  "autoload": {
    "psr-4": {
      "Brainstud\\HasIdentifier\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Brainstud\\HasIdentifier\\Tests\\": "tests"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit"
  },
  "require-dev": {
    "phpunit/phpunit": "^v13.1.4",
    "orchestra/testbench": "^v11.0.0"
  }
}
